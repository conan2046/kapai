  "acceptanceExamples": [
    {
      "id": "gameplay-authoritative-steam-5-entry-list",
      "given": "固定账号已到达HUD且function_dat.lua当前page非0条目可用",
      "when": "从HUD真实点击btn_wanfa并等待大厅稳定帧",
      "then": "Steam大厅严格显示1/3/6/9/10共5项并生成3行双列列表；steamEnabled=false的7/8/11/12/18/19/25/26和page=0的15/16/17不得出现"
    },
    {
      "id": "gameplay-current-interaction-boundary",
      "given": "ActivityLayer当前TaskBtn1/2的touchEnabled=false且只有EnterBtn可点击",
      "when": "点击卡片非按钮区域并覆盖5个Steam参加按钮",
      "then": "卡片主体不产生选择或详情；列表可滚动；参加按钮只验证目标模块、开放条件、路由所有权和不可用反馈，不进入或迁移独立子业务页面"
    },
    {
      "id": "gameplay-lock-and-open",
      "given": "分别使用低等级锁定样本与60级开放样本",
      "when": "检查5个Steam入口并点击实际可见参加按钮",
      "then": "锁定项显示N级开启且参加按钮隐藏；开放项显示参加；大厅不发送子模块协议"
    },
    {
      "id": "gameplay-scroll-lifecycle-isolation",
      "given": "5项Steam列表已渲染且账号A存在列表状态和红点缓存",
      "when": "滚动到底、返回重进、客户端重启、断线重连并切换账号B",
      "then": "3行列表布局与裁剪正确；重进重建默认顶部；红点只读当前会话权威缓存，账号A状态和pending不得进入账号B"
    },
    {
      "id": "gameplay-failure-boundary",
      "given": "配置/图标资源缺失、/65失败或静默、网络超时、功能未开放或目标服务不可用",
      "when": "进入大厅、刷新或点击相应入口",
      "then": "保持可观测安全态并显示原生锁定或不可用反馈；不崩溃、不造红点、不造业务数据、不发送子模块协议"
    }
  ],
