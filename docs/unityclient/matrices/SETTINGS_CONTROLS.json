{
  "schemaVersion": 1,
  "module": "Settings",
  "workflowPolicyVersion": 1,
  "hardGateVersion": 2,
  "acceptanceExamples": [
    {
      "id": "settings-device-persistence",
      "given": "固定账号首次启动且四个设置键缺失",
      "when": "从主界面真实入口打开设置，将音乐调为35%、音效调为65%，返回重进并重启客户端",
      "then": "首次显示音乐/音效开启且音量100%；修改后当前音频立即生效，返回重进和客户端重启均恢复35%/65%"
    },
    {
      "id": "settings-toggle-boundaries",
      "given": "音乐和音效均开启且存在非零音量",
      "when": "分别点击关闭开关，再点击开启开关，并拖动到0、100和中间边界",
      "then": "关闭时对应Slider为0且不可拖动；开启时恢复Cocos定义的100且可拖动；0/100/中间值均落盘并应用到对应音频通道"
    },
    {
      "id": "settings-corrupt-config",
      "given": "MusicVolume/EffectVolume 缺失、类型错误或数值小于0/大于1，或者持久化/音频服务不可用",
      "when": "启动并从真实入口打开设置或操作控件",
      "then": "缺失/损坏/越界值安全归一为源码默认1且界面不崩溃；无法保存或应用时保持可用页面并给出可验证失败状态，不伪报成功"
    },
    {
      "id": "settings-account-isolation",
      "given": "账号A已保存设备级35%/65%，账号B拥有不同角色身份",
      "when": "点击设置内切换账号并以账号B登录后重新打开设置",
      "then": "音频偏好按Cocos设备级语义仍为35%/65%，但头像、等级、角色名、服务器、UI栈、pending和角色Store只属于账号B，账号A数据不得残留"
    },
    {
      "id": "settings-external-boundaries",
      "given": "设置页已打开且角色等级满足或不满足公告条件",
      "when": "点击游戏公告、兑换码、金币加号或体力加号",
      "then": "只进入各自现有模块边界或显示原生失败提示；Settings不实现公告正文、兑换结算、商城、体力购买及任何支付活动逻辑"
    }
  ],
  "scope": {
    "fixedUserId": 7200057,
