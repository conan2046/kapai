{
  "schemaVersion": 1,
  "module": "XunBao",
  "scopeDecision": {
    "decision": "覆盖玩法大厅 function_id=9 至法宝搜索主界面、搜索确认/结果、合成表现、寻宝奖励任务列表/领取，以及 /319 op=28/29/30/31/36 和 /37 op=1/3 type=3。旧 G0-G6 证据不继承。",
    "confirmedByUser": true,
    "confirmedDate": "2026-09-08"
  },
  "scenarios": [
    {"id":"xunbao-entry-and-count","kind":"success","given":"固定账号等级达到 function_id=9 开放条件且 /319 op=31 可返回权威次数","when":"从玩法大厅真实点击法宝搜索并等待稳定帧","then":"主界面、剩余次数、恢复倒计时、货币栏及动态法宝列表与当前账号权威状态一致"},
    {"id":"xunbao-config-selection","kind":"success","given":"hecheng.type=8 的 45 条合成配置、45 个目标模板和 180 个碎片条目已加载","when":"真实点击动态法宝卡片并遍历蓝紫橙及经验书分支","then":"目标名称、品质面板、碎片槽、数量、缺失/可合成状态及 Open 时间轴均来自对应配置"},
    {"id":"xunbao-single-search","kind":"success","given":"当前碎片可搜索、剩余次数大于0且服务端存在对应掉落概率","when":"真实点击碎片槽加号发送 /319 op=28","then":"逐次奖励批次、权威剩余次数、恢复时间、背包碎片及搜索结果弹窗完整收敛"},
    {"id":"xunbao-auto-search","kind":"success","given":"功能1181已开放且剩余次数或搜宝令402满足来源规则","when":"真实点击一键搜索、确认自动使用规则并发送 /319 op=29","then":"确认弹窗、逐次奖励、权威剩余次数、搜宝令消耗和背包碎片一致"},
    {"id":"xunbao-single-compose","kind":"success","given":"当前 hecheng.type=8 目标的全部碎片数量满足成本","when":"真实点击合成发送 /319 op=30","then":"服务器原子扣除碎片并增加目标，播放对应品质 Compose 时间轴、粒子与合成成功弹窗，重登回读一致"},
    {"id":"xunbao-auto-compose","kind":"success","given":"至少两条 hecheng.type=8 配置可合成","when":"真实点击一键合成发送 /319 op=36","then":"全部可合成项目由服务器原子处理，奖励批次、背包和正式 Common.SaoDangUI / common/saodang.prefab 结果弹窗一致"},
    {"id":"xunbao-task-rewards","kind":"success","given":"正式daily.json存在119条type=3任务且固定账号服务端任务状态可查询","when":"真实点击寻宝奖励请求 /37 op=1 type=3，并对可领取任务发送 /37 op=3","then":"弹窗展示任务说明、进度、120条配置奖励的当前可见子集与领取状态，领取后服务端权威刷新且奖励到账"},
    {"id":"xunbao-navigation-boundary","kind":"success","given":"法宝搜索主界面已打开","when":"真实点击关闭、帮助、体力/金币加号、寻宝奖励或次数加号","then":"分别返回玩法大厅、打开来源说明/既有资源路由/正式寻宝任务列表/搜宝令402背包来源；隐藏元宝加号不接收射线"},
    {"id":"xunbao-failure-recovery","kind":"failure-boundary","given":"功能未开放、次数为0、掉落配置缺失、碎片不足、非法参数、静默回包、超时、断线、重连或切号","when":"经真实控件执行搜索、合成、关闭或切换账号","then":"不伪造成功、不客户端预扣、明确反馈并恢复交互；迟到回包不复活旧页且账号/SQLite状态隔离"}
  ],
