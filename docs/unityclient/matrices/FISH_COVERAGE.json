{
  "schemaVersion": 1,
  "module": "Fish",
  "scopeDecision": {
    "decision": "Steam单机采用场景54/map33假传送，角色固定在(1086,619)、dir=2、flip=true，传入后立即切换原版ShapeId=2000钓鱼造型；此时业务态为Ready，开始后才进入权威Fishing，收竿回持竿待机，退出恢复正常角色。保留容量9999格鱼篓与当前10种配置化鱼产出；10是鱼种数而非固定格数。同种鱼优先补已有未满格，单格堆叠上限999，满后新增同鱼种格，每格右下角显示数量；9999格均占用且本轮鱼种无未满同种格时，新鱼直接舍弃。每轮独立随机10至20秒。鱼的后续消耗用途暂不处理。移除主角钓鱼经验、交互币、房间、他人列表、抢夺、全服播报、限时窗、行走寻路传送与钓点选择。",
    "confirmedByUser": true,
    "confirmedDate": "2026-09-14",
    "g0BlockedBy": []
  },
  "scenarios": [
    {"id":"fish-entry-map","kind":"success","given":"固定账号达到10级且function_id=32开放，map33与ShapeId=2000正式资源可解析","when":"点击Function_32入口","then":"假传送进入场景54/map33表现，角色固定在(1086,619)、dir=2、flip=true并立即切换ShapeId=2000钓鱼造型；业务态仍为Ready，不发op5、不扣金币、不启动倒计时，每日不限次"},
    {"id":"fish-start-cycle","kind":"success","given":"角色已在固定钓位以ShapeId=2000持竿待机、产出鱼存在可补同种格或鱼篓仍有空格，且金币不少于100","when":"点击开始钓鱼并等待周期结束","then":"固定发送op5(dir=2)，成功时权威扣100金币、业务态切为Fishing并返回本轮10至20秒时长；钓鱼造型保持，到期只产出配置鱼种并为下一轮重抽时长"},
    {"id":"fish-basket-collect","kind":"success","given":"鱼篓存在有效鱼","when":"选择鱼格并领取","then":"背包增加对应鱼且鱼篓刷新"},
    {"id":"fish-stop-close-reconnect","kind":"success","given":"模块处于Fishing或持竿待机Ready","when":"Fishing中点击收网、关闭或重连","then":"收网按点击时刻结算，成功率=已用时/本轮时长；成功获得鱼，失败不产出且不自动续轮；退出页面恢复正常角色模型并清理钓鱼模型、计时器与pending；重连由权威状态重建"},
    {"id":"fish-function-gate","kind":"failure-boundary","given":"未达10级","when":"查看或点击入口","then":"锁定或拒绝且不进入模块"},
    {"id":"fish-insufficient-gold","kind":"failure-boundary","given":"金币小于配置消耗100","when":"在固定钓位点击开始钓鱼","then":"不扣金币、不进入Fishing、不产出奖励并精确提示，仍保持ShapeId=2000持竿待机"},
    {"id":"fish-protocol-error","kind":"failure-boundary","given":"服务端返回op0或业务失败","when":"客户端解析回包","then":"精确提示且不乐观修改状态"},
    {"id":"fish-config-boundary","kind":"failure-boundary","given":"fish_settings/fish_reward/fish_position/10种item镜像/map33/ShapeId=2000模型动画缺失或非法","when":"进入模块或开始钓鱼","then":"停止并报告具体配置错误，不使用临时钓位、普通角色站立或占位资源"},
    {"id":"fish-basket-full-discard","kind":"failure-boundary","given":"鱼篓9999格均已占用且本轮鱼种无未满同种格","when":"结算本轮鱼产出","then":"直接舍弃本次鱼，不新增、不覆盖、不修改任何鱼格，并明确提示鱼篓已满"},
    {"id":"fish-empty-or-invalid-slot","kind":"failure-boundary","given":"选中空鱼格、越界索引或背包不足","when":"点击领取","then":"不发奖、不重复领取并精确提示"},
    {"id":"fish-multiplayer-removed","kind":"exclusion","given":"Steam单机模块已打开","when":"检查UI与/217收发","then":"多人、抢夺和全服广播分支均不可达"}
  ],
