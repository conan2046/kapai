  "acceptanceExamples": [
    {
      "id": "hero-rebirth-authoritative-success",
      "given": "固定SQLite角色拥有一名未上阵且等级、突破、修炼均大于初始值的神将，并至少有50绑定元宝",
      "when": "从真实回收入口选择该神将，核对/24 op=8返还预览并在确认弹窗点击确认",
      "then": "仅在/24 op=9成功后扣除50绑定元宝、神将等级/突破/修炼归零而星级保持，返还资源按权威结果到账，重登保持"
    },
    {
      "id": "hero-rebirth-insufficient-currency",
      "given": "固定角色绑定元宝少于50且存在可重生神将",
      "when": "选择神将并点击真实重生按钮",
      "then": "显示与Cocos一致的元宝不足提示，不发送成功事务且神将和背包资源均不变化"
    },
    {
      "id": "hero-rebirth-deployed-rejection",
      "given": "目标神将处于出战阵位且已有突破进度",
      "when": "服务端收到/24 op=8或op=9的该神将ID",
      "then": "返回可解释失败，绑定元宝、神将进度和背包资源原子不变"
    },
    {
      "id": "hero-rebirth-cancel-lifecycle",
      "given": "返还预览和确认弹窗已显示",
      "when": "分别点击关闭与取消，并执行返回重进、断线重连和切号",
      "then": "不产生写操作，旧选择、pending和弹窗不残留，finally精确恢复projectx.db"
    }
  ],
