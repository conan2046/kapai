  "acceptanceExamples": [
    {
      "id": "stamina-free-claim-authority",
      "given": "固定主账号体力为40，第1档处于12:00-14:00且状态为1",
      "when": "从玩法大厅真实进入并点击第1档领取按钮",
      "then": "客户端发送/321 op=3,idx=1,type=0；服务端返回成功后体力40→90、第1档1→3、奖励提示显示50体力且红点按剩余可领档刷新"
    },
    {
      "id": "stamina-paid-claim-authority",
      "given": "固定主账号体力为40、元宝为100，第1档已过领取时段且状态为2",
      "when": "点击第1档并在20元宝补领确认框选择确定",
      "then": "客户端发送/321 op=3,idx=1,type=1；服务端成功后体力40→90、元宝100→80、第1档2→3，UI只在权威回包后更新"
    },
    {
      "id": "stamina-paid-cancel-no-mutation",
      "given": "任一档状态为2且补领确认框已显示20元宝成本",
      "when": "点击取消或关闭确认框",
      "then": "不发送/321 op=3，体力、元宝、领取状态与红点均不变化"
    },
    {
      "id": "stamina-duplicate-rejected",
      "given": "第1档已通过真实op=3领取并持久状态为3",
      "when": "再次对第1档发起领取并回查op=2",
      "then": "服务端明确拒绝重复领取，体力与元宝不再变化，回查仍为3，Unity显示失败反馈而不伪造奖励"
    },
    {
      "id": "stamina-cap-rejected",
      "given": "账号当前体力加50超过服务端MAX_SPIRIT",
      "when": "点击状态1或2的领取按钮",
      "then": "客户端或服务端以原生上限提示拒绝，op=3不得产生奖励、扣款或状态3"
    },
    {
      "id": "stamina-reentry-reconnect-persistence",
      "given": "第1档领取成功且主账号已正常保存",
      "when": "关闭返回、重新进入、断线重连并重新登录",
      "then": "op=2持续返回第1档状态3，体力和扣款与服务端持久值一致，无重复监听、重复奖励或旧页面残留"
    },
    {
      "id": "stamina-account-isolation-restore",
      "given": "主账号与隔离账号均已独立快照且只有主账号执行领取",
      "when": "切换到隔离账号回查，再恢复两账号并重登录计算哈希",
      "then": "隔离账号不继承主账号三档/体力/元宝状态；两账号恢复哈希等于各自快照且Fixture残留为0"
    }
  ],
