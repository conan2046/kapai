    {
      "id": "soul-shop-authoritative-purchase",
      "given": "固定账号 type=2 六格中第一件未购买且神魂充足",
      "when": "玩家从真实购买按钮购买 1 件",
      "then": "/221 op=2 成功后权威扣除真实货币、发放配置奖励、商品变已购，重拉和重登一致"
    },
    {
      "id": "soul-shop-entry-return",
      "given": "玩家位于主界面、招募页、背包获取途径或封神列传获取途径",
      "when": "点击将魂商店并关闭",
      "then": "所有入口打开同一 type=2 页面，关闭返回原页面且不残留公共框、pending、监听或重复 UI 栈"
    }
  ],
  "scope": {
    "screenSize": "1334x750",
    "windowsDpi": "100%",
    "fixedUserId": 7200057,
    "fixedRoleId": 1000003,
    "cocosFixedUserId": 7200057,
    "cocosFixedRoleId": 1000115,
    "included": [
      "将魂商店 type=2 的 724 条配置候选、服务端随机六格、两类真实成本及六格详情/购买",
      "主界面商城弹层、招募页商店、招募页神魂加号、背包获取途径、封神列传获取途径的 function_id=15 入口",
      "/221 op=1 查询、op=2 单件购买、op=3 免费/刷新令刷新、op=4 购买次数及成功失败结构",
      "标题、帮助、关闭、元宝边界、神魂详情、免费次数、恢复倒计时、刷新令、剩余次数、折扣、已购、奖励与 Toast",
      "返回重进、权威重拉、断线重连、切号清理及基础 Shop /221 pending 隔离"
    ],
    "excludedMustBeHiddenOrDisabled": [
      "Cocos Lua 保留 yuanbao/add 回调但当前运行态无可见可达控件，不计入将魂商店当前控件分母",
      "招募页 GoldIcon2/AddBtn 当前打开道具兑换，不是将魂商店入口；将魂商店仅使用招募页底部 Shop",
      "基础商城 type=1 由 Shop 模块负责，不得被 GameplayShopController 消费",
      "竞技/血战/昆仑/帮派 type=3..8/23/25/26 属 Steam 排除模块，本轮不开放",
      "转盘及其他玩法商店 type=27..30 暂不修复，本轮不开放",
      "充值、VIP、渠道支付不属于本模块；元宝加号只显示 Steam 范围边界反馈",
      "客户端配置补齐、伪造六格、乐观扣款和本地成功结果均禁止"
    ],
    "sharedGlobalControlsOwnedElsewhere": [
      "shop/shop_bg 标题、帮助、关闭由公共一级框架提供，本模块绑定真实回调并负责返回原页面",
      "Reward、ItemDetail、Toast、Loading、断线与重连提示由公共组件提供，本模块必须从真实将魂控件触发并验收"
    ],
