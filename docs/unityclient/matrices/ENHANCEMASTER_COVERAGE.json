  "scopeDecision": {
    "decision": "独立覆盖强化大师入口、装备强化/精炼/觉醒/神铸、法宝强化/精炼；HeroEquip仅作为共享装备状态回归，不扩写其既有方案A边界。",
    "confirmedByUser": true,
    "confirmedDate": "2026-08-24"
  },
  "scenarios": [
    {"id":"em-master-open","kind":"success","given":"两名阵位神将及装备/法宝权威数据已返回","when":"从阵容点击强化大师并切换六个页签","then":"六类大师等级、条件和属性按type 1..6显示，选择神将后同步刷新"},
    {"id":"em-master-boundary","kind":"failure-boundary","given":"空阵位、配置缺失、断线、延迟推送或切号","when":"打开、关闭或切换强化大师","then":"显示安全空态或明确反馈，不串页、不复活旧页面、不污染新账号"},
    {"id":"em-equip-strength","kind":"success","given":"装备、金币及强化等级条件满足","when":"执行一次、五次或全身强化","then":"装备等级、金币、大师、神将属性和总战力按权威多推送收敛"},
    {"id":"em-equip-strength-boundary","kind":"failure-boundary","given":"满级、金币不足、非法UID或请求超时","when":"触发装备强化","then":"数据原子不变且反馈明确，关闭页面后迟到回包不重开页面"},
    {"id":"em-equip-refine","kind":"success","given":"四类精炼材料及目标等级有效","when":"执行精炼一级或自动精炼","then":"材料、经验、等级、属性、大师及重登回读一致"},
    {"id":"em-equip-refine-boundary","kind":"failure-boundary","given":"材料不足、数量越界、满级或配置缺失","when":"确认装备精炼","then":"不扣料、不预改等级，弹窗和主页面状态一致"},
    {"id":"em-equip-awaken","kind":"success","given":"角色等级、橙色以上装备、碎片、觉醒石和金币满足","when":"点击觉醒","then":"觉醒等级、附加属性、资源、大师和持久化一致"},
    {"id":"em-equip-awaken-boundary","kind":"failure-boundary","given":"绿色装备、等级不足、材料不足或满级","when":"进入或点击觉醒","then":"保持当前装备并显示原版限制反馈，资源不变"},
    {"id":"em-equip-shenzhu","kind":"success","given":"角色等级、红色装备、神铸碎片和金币满足","when":"点击神铸并查看技能效果","then":"神铸等级、技能、资源、Imod反馈、大师和持久化一致"},
    {"id":"em-equip-shenzhu-boundary","kind":"failure-boundary","given":"绿色装备、等级不足、材料不足或151..155配置边界","when":"进入、执行或查看神铸","then":"不越界显示、不扣资源且失败反馈明确"},
    {"id":"em-fabao-strength","kind":"success","given":"目标法宝及可消耗法宝/经验书有效","when":"手选材料、一键添加并强化","then":"材料法宝被权威消耗，目标经验/等级、属性、大师及重登回读一致"},
    {"id":"em-fabao-strength-boundary","kind":"failure-boundary","given":"无可选材料、选择已装备/已培养法宝、满级或请求失败","when":"选择材料或强化","then":"非法材料不可选，失败不消费且选择器生命周期正确"},
    {"id":"em-fabao-refine","kind":"success","given":"法宝精华和金币满足且目标未满级","when":"点击法宝精炼","then":"精炼等级、属性、资源、大师和重登回读一致"},
    {"id":"em-fabao-refine-boundary","kind":"failure-boundary","given":"材料不足、满级、非法UID、断线或切号","when":"执行法宝精炼或接收迟到推送","then":"数据原子、游标隔离且旧账号页面不复活"},
    {"id":"em-protocol-transaction","kind":"success","given":"/8、/15、/18、/70、/319权威状态与固定夹具一致","when":"经真实控件执行查询或写操作","then":"所有响应与中间推送收敛到同一SQLite事务和重登状态"},
    {"id":"em-protocol-boundary","kind":"failure-boundary","given":"错误码、缺字段、乱序、重复、静默、超时、断线或切号","when":"请求进行中关闭/切换页面","then":"无客户端预改、无流错位、无叠层残留且Fixture可精确恢复"}
  ],
