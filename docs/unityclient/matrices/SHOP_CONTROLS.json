{
  "schemaVersion": 1,
  "module": "Shop",
  "hardGateVersion": 1,
  "scope": {
    "screenSize": "1334x750",
    "included": [
      "当前《道友来封神》主界面商城展开入口、基础商城子入口和金币加号快捷入口",
      "基础商城 type=1 的唯一页签、三列动态商品、滚动、选中、名称、描述、价格、折扣、原价、限购和售罄态",
      "数量减、数量加、数量输入弹窗、单次及多数量购买、购买确认/取消、奖励展示",
      "/221 op=1 列表、op=2 购买、op=3 刷新、op=4 购买计数的成功和失败结构",
      "刷新次数、免费次数、倒计时、货币余额、不足/非法/重复/限购失败、空态、重拉、返回重进、断线重连和切号清理"
    ],
    "sharedGlobalControlsOwnedElsewhere": [
      "一级框架标题、货币栏和关闭按钮由通用 UI 框架负责，Shop 负责真实绑定及返回结果",
      "购买确认/取消由通用 MessageBox 负责",
      "奖励物品、奖励详情和关闭由通用 Reward/ItemDetail 组件负责",
      "Toast、Loading、断线和重连提示由通用网络/UI 层负责"
    ],
    "approvedUnityFixesToProveAtG5": [
      "当前 Cocos 基础商城没有手动刷新按钮，也不显示 /221 返回的刷新次数/免费次数/倒计时；Unity 按目标要求补真实 op=3 控件和权威状态，不伪造结果",
      "当前 Cocos btn_Buy 直接发送 /221 op=2；Unity 按目标要求增加购买确认/取消安全步骤，确认后才发包",
      "当前 Cocos /221 op=2 明确显示成功 Toast，奖励弹窗是否出现必须在 G1 运行取证；Unity 奖励展示只能使用权威回包"
    ],
    "excludedMustBeHiddenOrDisabled": [
      "将魂、竞技场、血战、七日半价、昆仑、帮派、转盘等 type=2..8 商店不属于本模块",
      "神秘、绑定元宝、积分、帮贡、NPC、特供、神魄、砸蛋等旧 ShopUI 分支未从当前基础商城入口合格到达",
      "充值、VIP、渠道支付和货币购买不属于本模块",
      "商品格 ItemCellUI:SetCanClick(false)，当前 Cocos 不允许点击商品图标打开独立物品详情；Unity 不新增该空壳入口"
    ],
    "fixedUserId": 7200057,
    "fixedRoleId": 1000115,
    "mutationFixture": "G4 每次分配全新 isolated-role；固定账号仅用于 G1/G5 同数据视觉对照，必须由 Shop 专用适配器快照、注入、finally 精确恢复、哈希断言和重登录复核",
    "windowsDpi": "100%"
  },
