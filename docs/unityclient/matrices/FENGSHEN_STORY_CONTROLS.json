  "acceptanceExamples": [
    {
      "id": "fengshen-current-stage-authority",
      "given": "固定账号经玩法大厅 function_id=3 进入，服务端 /320 op=24 返回当前章、当前关和剩余次数",
      "when": "选择当前章节并点击当前关卡",
      "then": "主页四关状态、剩余次数和关卡弹窗均只由权威返回及当前配置渲染；当前关显示挑战/布阵，已过关只显示已通关，未解锁点击仅出现原生提示"
    },
    {
      "id": "fengshen-mutation-restore",
      "given": "夹具已快照列传存档、体力、背包、货币、任务及战斗关联数据",
      "when": "真实执行 /320 op=25 的成功、失败、重登、断线重连和切号闭环",
      "then": "服务端副作用可观测且最终主账号完整 SHA 恢复、隔离账号无串号、Fixture residual=0"
    },
    {
      "id": "fengshen-chapter-reward-authority",
      "given": "当前 Cocos 的 op24 宝箱状态解析已注释，m_giftBoxs 不会产生可领态；服务端只在 op25 通关末关后推送 op26 奖励",
      "when": "真实挑战章末关胜利并收到 op10/op26",
      "then": "奖励已经由服务端发放，弹窗确定按钮仅确认关闭；Unity 不得发送 op26 领取请求或制造可领红点"
    },
    {
      "id": "fengshen-chapter-arrow-page",
      "given": "封神列传章节视窗宽 990px、章节单元宽 165px，当前页可见 6 章且章节总数超过一页",
      "when": "点击左箭头或右箭头一次",
      "then": "Unity 将章节视窗向对应方向翻动 6 章并在首尾边界夹紧；选中章、四关状态、裁剪和当前章定位保持正确，不发送协议"
    }
  ],
