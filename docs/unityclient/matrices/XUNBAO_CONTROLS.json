    {
      "id": "xunbao-single-search-result",
      "given": "固定账号在法宝搜索页拥有至少1次搜索次数，蓝色法宝1001的碎片4701可搜索且掉落配置有效",
      "when": "用户真实点击 Add1，经 /319 op=28 完成一次搜索",
      "then": "Cocos与Unity均展示逐次奖励结果，权威剩余次数减少1，背包4701数量按服务端奖励变化且重登一致"
    },
    {
      "id": "xunbao-zero-count-source",
      "given": "固定账号剩余搜索次数为0",
      "when": "用户真实点击碎片加号、一键搜索或次数加号",
      "then": "不发送会伪造成功的搜索请求，打开并选中背包搜宝令402；道具不存在时显示可见缺失反馈且控件恢复可交互"
    },
    {
      "id": "xunbao-compose-feedback",
      "given": "固定账号拥有法宝1001配方4701/4702/4703各1个且尚未拥有目标法宝",
      "when": "用户真实点击合成，经 /319 op=30 成功",
      "then": "碎片原子扣除、目标法宝增加，播放 BlueCompose 时间轴、粒子和 Xunbao_popupLayer 合成成功弹窗，重登回读一致"
    },
    {
      "id": "xunbao-task-rewards",
      "given": "固定账号存在服务端 /37 type=3 法宝搜索任务，正式 daily.json 含任务25至143及奖励配置",
      "when": "用户真实点击寻宝奖励，并在可领取状态点击领取",
      "then": "Unity请求 /37 op=1 type=3，按任务进度展示说明、奖励图标、数量和领取状态；领取经 /37 op=3 type=3 后权威刷新且奖励到账"
    }
  ],
