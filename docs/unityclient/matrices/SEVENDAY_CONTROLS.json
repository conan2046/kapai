  "acceptanceExamples": [
    {
      "id": "seven-day-list-authority",
      "given": "固定主账号从玩法大厅 function_id=11 真实进入七日目标",
      "when": "客户端发送 /37 op=4",
      "then": "按服务端 count 与 taskId/progress/state 完整重建任务、进度奖励、红点和按钮态，不混入普通任务 Store"
    },
    {
      "id": "seven-day-claim-authority",
      "given": "Fixture 将一个当前开放日任务精确设置为 state=1 并保存快照",
      "when": "点击领取并发送 /37 op=6 + taskId",
      "then": "仅在 PRO_SUCCESS 奖励回包后显示奖励并将该任务变为 state=2，重进和重登录仍保持已领取"
    },
    {
      "id": "seven-day-claim-rejected",
      "given": "任务未完成、未到开放日或已经领取",
      "when": "尝试领取",
      "then": "客户端阻止无效点击或服务端明确拒绝，奖励、任务状态和货币均不变化"
    },
    {
      "id": "seven-day-go-route",
      "given": "未完成任务配置 jump 大于 0",
      "when": "点击前往",
      "then": "关闭七日目标并交给既有 function 路由；返回后重新 op=4，不伪造进度"
    },
    {
      "id": "seven-day-discount-shop-boundary",
      "given": "选择已开放日的限时折扣分类并有合法商品",
      "when": "查询或购买商品",
      "then": "复用共享 /221 type=10-16 权威列表和购买结果，成功更新次数，余额不足或售罄无副作用"
    },
    {
      "id": "seven-day-lifecycle-isolation-restore",
      "given": "主账号与隔离账号均完成独立快照",
      "when": "主账号领取后执行关闭重进、断线重连、重登录和切换隔离账号，再恢复 Fixture",
      "then": "状态持久、无重复监听；隔离账号不继承主账号状态；两账号恢复哈希与快照一致且残留为0"
    }
  ],
