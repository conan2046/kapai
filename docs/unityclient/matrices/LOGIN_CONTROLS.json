{
  "schemaVersion": 1,
  "module": "Login",
  "workflowPolicyVersion": 1,
  "hardGateVersion": 2,
  "acceptanceExamples": [
    {
      "id": "login-existing-role",
      "given": "固定账号已唯一绑定现有角色，游戏服和公告夹具可用",
      "when": "从本地登录页点击进入游戏并完成 /1001 与 /1004",
      "then": "必须进入当前 UImainLayer，角色快照全部读完且 Remaining=0，随后发送 /88；不得创建新角色或显示其他账号数据"
    },
    {
      "id": "login-create-role-valid",
      "given": "隔离账号在快照中没有角色且候选名称合法、未占用",
      "when": "经 /1001 roleId=0 进入 RoleCreateLayer，选择性别、输入名称并点击创建",
      "then": "必须由真实 /1003 创建且自动发送 /1004，重登录仍读回同一角色；finally 删除新角色并恢复账号快照"
    },
    {
      "id": "login-create-role-rejected",
      "given": "隔离账号没有角色，名称为空、超过六字、含限制字符或已被占用",
      "when": "在 RoleCreateLayer 点击创建",
      "then": "客户端前置或服务端 /1002、/1003 必须拒绝并显示对应错误，账号仍无角色且不得留下角色或 Fixture 残留"
    },
    {
      "id": "login-account-isolation",
      "given": "账号A与账号B分别绑定不同角色",
      "when": "账号A登录后返回登录页，再以真实 /1001 切换至账号B并重进",
      "then": "Lua模型、C#镜像、pending、监听和UI栈必须清空A，仅显示B的 /1004 权威快照；再次切回A仍无B残留"
    },
    {
      "id": "login-network-recovery",
      "given": "登录连接发生拒绝、超时或已登录后断线",
      "when": "等待超时或在连接错误弹窗选择重试",
      "then": "等待态必须结束，错误信息可见；重试重新执行连接与 /1001→/1004，取消返回登录且不保留半登录角色态"
    }
  ],
  "scope": {
    "screenSize": "1334x750",
    "windowsDpi": "100%",
    "fixedExistingAccount": "7200057 / 1000115",
    "terminalIsolationAccount": "705213 / 1000006",
