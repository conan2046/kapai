  "acceptanceExamples": [
    {
      "id": "bag-current-entry",
      "given": "固定账号已进入当前主界面且 btn_Bag 可见",
      "when": "真实点击 btn_Bag",
      "then": "只发送 /8 并打开包裹一级页；不得依赖旧 btn_beibao 路径或屏幕坐标补丁"
    },
    {
      "id": "bag-aggregate-and-use",
      "given": "同一 itemId=500 分布在两个服务端槽位且合计20个",
      "when": "进入包裹并从批量弹窗使用10个",
      "then": "列表只显示一个体力丹条目和总数20；确认发送首个权威槽位与数量10，服务端成功后体力增加250且剩余总数10"
    },
    {
      "id": "bag-choice-authority",
      "given": "任选礼包1111数量3且八个候选可见",
      "when": "选择候选4621并确认使用2个",
      "then": "发送 /15 op=1,target=1,num=2；权威回包后1111剩1、4621增加2，重进与重登录一致"
    },
    {
      "id": "bag-source-boundary",
      "given": "候选奖励具有来源配置且目标模块可能保留或明确排除",
      "when": "点击候选图标并触发来源动作",
      "then": "来源详情、滚动与返回正确；已迁移目标走真实入口，排除目标保持当前页并明确禁用，不显示开发占位文案"
    },
    {
      "id": "bag-exact-restore",
      "given": "真实使用已改变 package、user_spirit 或贵族经验",
      "when": "验证结束执行 finally 恢复并重登录",
      "then": "完整 role_info 与所属 user_info 分片行哈希等于 Setup 前快照，Fixture 残留为0"
    }
  ],
