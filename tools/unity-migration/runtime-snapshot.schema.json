{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projectx.local/schemas/runtime-snapshot-v1.json",
  "title": "ProjectX dual-engine runtime action snapshot",
  "type": "object",
  "required": [
    "schemaVersion", "recordType", "module", "stateId", "actionId", "controlId",
    "sequence", "timestampUtc", "engine", "operationType", "inputMode", "inputCoordinates",
    "preUiTreeHash", "preUiTree", "preUiTreeRef", "preUiTreeNodeCount", "targetNodePath", "targetSemanticId", "hitTest",
    "engineEventDispatched", "protocol", "changedNodes", "postUiTreeHash", "postUiTree", "postUiTreeRef", "postUiTreeNodeCount",
    "stableState", "animation", "visualStateId", "identity", "resolution", "inputFingerprint",
    "automationPassed", "engineInputReplayPassed", "protocolSemanticPassed", "runtimeTreePassed"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordType": { "const": "action" },
    "module": { "type": "string", "minLength": 1 },
    "stateId": { "type": "string", "minLength": 1 },
    "actionId": { "type": "string", "minLength": 1 },
    "controlId": { "type": "string", "minLength": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestampUtc": { "type": "string", "format": "date-time" },
    "engine": { "enum": ["cocos", "unity"] },
    "operationType": {
      "enum": ["open", "click", "pointerDown/pointerUp", "drag", "scroll", "textInput", "close", "back", "reconnect", "relogin", "accountSwitch"]
    },
    "inputMode": { "const": "engine-input-replay" },
    "inputCoordinates": {
      "type": "object",
      "required": ["x", "y", "coordinateSpace"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1334 },
        "y": { "type": "number", "minimum": 0, "maximum": 750 },
        "coordinateSpace": { "const": "1334x750-top-left" }
      },
      "additionalProperties": false
    },
    "preUiTreeHash": { "$ref": "#/$defs/sha256" },
    "preUiTree": { "type": "array", "items": { "$ref": "#/$defs/uiNode" } },
    "preUiTreeRef": { "type": ["string", "null"] },
    "preUiTreeNodeCount": { "type": "integer", "minimum": 0 },
    "targetNodePath": { "type": "string", "minLength": 1 },
    "targetSemanticId": { "type": "string", "minLength": 1 },
    "hitTest": {
      "type": "object",
      "required": ["hits", "firstHit"],
      "properties": {
        "hits": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "firstHit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "engineEventDispatched": { "type": "boolean" },
    "protocol": {
      "type": "object",
      "required": ["sent", "received", "errors", "timedOut", "disconnected"],
      "properties": {
        "sent": { "type": "array", "items": { "$ref": "#/$defs/packet" } },
        "received": { "type": "array", "items": { "$ref": "#/$defs/packet" } },
        "errors": { "type": "array", "items": { "type": "string" } },
        "timedOut": { "type": "boolean" },
        "disconnected": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "changedNodes": { "type": "array", "items": { "type": "string" } },
    "postUiTreeHash": { "$ref": "#/$defs/sha256" },
    "postUiTree": { "type": "array", "items": { "$ref": "#/$defs/uiNode" } },
    "postUiTreeRef": { "type": ["string", "null"] },
    "postUiTreeNodeCount": { "type": "integer", "minimum": 0 },
    "stableState": {
      "type": "object",
      "required": ["outcome", "stableFrames", "reason", "elapsedMs"],
      "properties": {
        "outcome": { "enum": ["stable", "business-error", "timeout", "disconnected"] },
        "stableFrames": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string" },
        "elapsedMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "animation": {
      "type": "object",
      "required": ["started", "ended", "durationMs", "cleanupPassed"],
      "properties": {
        "started": { "type": "boolean" },
        "ended": { "type": "boolean" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "cleanupPassed": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "visualStateId": { "type": ["string", "null"] },
    "identity": {
      "type": "object",
      "required": ["account", "userId", "roleId"],
      "properties": {
        "account": { "type": "string" },
        "userId": { "type": "integer", "minimum": 0 },
        "roleId": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": ["width", "height", "dpiScale"],
      "properties": {
        "width": { "const": 1334 },
        "height": { "const": 750 },
        "dpiScale": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "inputFingerprint": { "$ref": "#/$defs/sha256" },
    "automationPassed": { "type": "boolean" },
    "engineInputReplayPassed": { "type": "boolean" },
    "protocolSemanticPassed": { "type": "boolean" },
    "runtimeTreePassed": { "type": "boolean" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "packet": {
      "type": "object",
      "required": ["sequence", "command", "op", "decodedFields", "length", "rawPacketHash", "timestampUtc"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "command": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "op": { "type": ["integer", "null"] },
        "decodedFields": { "type": "object" },
        "length": { "type": "integer", "minimum": 0 },
        "rawPacketHash": { "$ref": "#/$defs/sha256" },
        "timestampUtc": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "uiNode": {
      "type": "object",
      "required": [
        "semanticId", "controlId", "nodePath", "nodeType", "parentPath", "siblingIndex",
        "active", "selfVisible", "effectiveVisible", "enabled", "interactable", "raycast",
        "opacity", "color", "anchor", "pivot", "localPosition", "worldPosition", "screenRect",
        "width", "height", "scale", "rotation", "clippingRect", "text", "font", "fontSize",
        "resource", "source", "animationResource", "animationAction", "scroll", "toggle", "inputValue",
        "dataId", "dataIndex"
      ],
      "properties": {
        "semanticId": { "type": "string" }, "controlId": { "type": ["string", "null"] },
        "nodePath": { "type": "string" }, "nodeType": { "type": "string" }, "parentPath": { "type": ["string", "null"] },
        "siblingIndex": { "type": "integer" }, "active": { "type": "boolean" }, "selfVisible": { "type": "boolean" },
        "effectiveVisible": { "type": "boolean" }, "enabled": { "type": "boolean" }, "interactable": { "type": "boolean" },
        "raycast": { "type": "boolean" }, "opacity": { "type": "number" }, "color": { "type": "string" },
        "anchor": { "$ref": "#/$defs/vector2" }, "pivot": { "$ref": "#/$defs/vector2" },
        "localPosition": { "$ref": "#/$defs/vector2" }, "worldPosition": { "$ref": "#/$defs/vector2" },
        "screenRect": { "$ref": "#/$defs/rect" }, "width": { "type": "number" }, "height": { "type": "number" },
        "scale": { "$ref": "#/$defs/vector2" }, "rotation": { "type": "number" }, "clippingRect": { "anyOf": [{ "$ref": "#/$defs/rect" }, { "type": "null" }] },
        "text": { "type": ["string", "null"] }, "font": { "type": ["string", "null"] }, "fontSize": { "type": ["number", "null"] },
        "resource": { "type": ["string", "null"] }, "source": { "type": ["string", "null"] },
        "animationResource": { "type": ["string", "null"] }, "animationAction": { "type": ["string", "null"] },
        "scroll": { "type": ["object", "null"] }, "toggle": { "type": ["boolean", "null"] },
        "inputValue": { "type": ["string", "null"] }, "dataId": { "type": ["string", "null"] }, "dataIndex": { "type": ["integer", "null"] }
      },
      "additionalProperties": true
    },
    "vector2": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } }, "additionalProperties": false },
    "rect": { "type": "object", "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "width": { "type": "number" }, "height": { "type": "number" } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
