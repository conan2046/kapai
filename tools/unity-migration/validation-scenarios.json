{
  "schemaVersion": 1,
  "artifactPolicy": {
    "immutableRoots": [".local/ui-fidelity"],
    "runtimeRoots": ["build/ui-migration", ".local/unity-validation"],
    "defaultLifecycle": "runtime"
  },
  "workflowPolicy": {
    "version": 1,
    "cocos": {
      "tool": "computer-use@openai-bundled",
      "requestedAppReference": "plugin://computer-use@openai-bundled?app=com.adspower.global",
      "targetProcess": "ProjectX.exe",
      "targetWindow": "Cocos Simulator",
      "mode": "observe-one-action-refresh-then-diagnose",
      "approvalMode": "routine-project-actions-preapproved",
      "ledgerWriter": "tools/unity-migration/Update-UnityMigrationOperationLedger.ps1",
      "maximumAttemptsPerTarget": 1,
      "requireAutomationLedger": true,
      "forbidDesktopCapture": true,
      "forbidHistoricalEvidence": true,
      "forbidPowerShellUiAutomationMix": true,
      "routineActionsPreapproved": true,
      "highRiskConfirmationsRemain": true
    },
    "unity": {
      "standardRunner": "tools/unity-migration/Run-UnityModuleValidation.ps1",
      "fixedAccountRunner": "tools/unity-migration/Run-UnityFixedAccountValidation.ps1",
      "runtimeValidationMode": "batch-only",
      "mcpScope": "g3-editor-inspection-only",
      "requireRegisteredArtifactsBeforeG3": true,
      "requireDataPreflightBeforeFullRun": true
    },
    "sequence": {
      "requireCurrentCocosBeforeG2": true,
      "requireSourceContractsBeforeG3": true,
      "requireControlCoverageBeforeG4": true,
      "requireG5ContractBeforeFullRun": true,
      "visualReplayIsNotG5Evidence": true,
      "requireTwoBuildBatchRunsForG6": true
    },
    "iteration": {
      "operationLedgerPattern": ".local/unity-validation/{module}-operation-ledger.json",
      "retrospectivePattern": ".local/unity-validation/{module}-retrospective-latest.json",
      "recordEveryFailure": true,
      "requireFailureRootCause": true,
      "requireResolutionAndIterationEvidenceBeforeG6": true,
      "autoSummarizeAtG6": true,
      "requireToolchainTestForPolicyIteration": true
    }
  },
  "scenarios": [
