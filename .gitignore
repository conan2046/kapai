# ============================================================
# 构建产物 / 本地运行环境（禁止入库）
# ============================================================
build/
.local/
logs/
*.obj
*.tlog
*.pdb
*.lib
*.so
*.a
*.dylib
*.bin
# 注意：*.dll / *.exe 等构建产物位于 frameworks/simulator（目录已排除）

# ============================================================
# 第三方依赖与引擎（体积巨大，按"标准分层"用子模块/脚本引入）
# ============================================================
# Cocos2d-x 引擎（快照 3.3G）：通过子模块或 Setup-Engine 脚本引入，不入库
client/ProjectX/frameworks/
# 模拟器运行时构建产物（523M）：纯编译输出，禁止入库
client/ProjectX/simulator/
# vcpkg 依赖（1.6G）：通过子模块或 Setup-Deps 脚本引入，不入库
tools/local/vcpkg/

# Unity 本机缓存/生成工程（unityclient 的 Assets、Packages、ProjectSettings 保留）
unityclient/[Ll]ibrary/
unityclient/[Tt]emp/
unityclient/[Oo]bj/
unityclient/[Ll]ogs/
unityclient/[Uu]ser[Ss]ettings/
unityclient/*.csproj
unityclient/*.sln
unityclient/*.suo
unityclient/.vs/

# ============================================================
# 智能体工作记忆（非项目源码，避免泄露内部备注）
# ============================================================
.workbuddy/

